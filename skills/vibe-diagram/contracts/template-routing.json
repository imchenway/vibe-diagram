{
  "schema_version": 2,
  "code_review_routes": {
    "cause-evidence": {
      "family": "fault-debugging",
      "template": "causal-chain",
      "primary_relation": "evidence, cause, impact, remediation, and verification"
    },
    "control-branch": {
      "family": "business-flow",
      "template": "logic-flowchart",
      "primary_relation": "condition, branch, merge, or bounded decision loop"
    },
    "exception-compensation": {
      "family": "business-flow",
      "template": "exception-branch-flow",
      "primary_relation": "failure origin, compensation, retry, fallback, or rejoin"
    },
    "path-contract-drift": {
      "family": "business-flow",
      "template": "dual-path-swimlane",
      "primary_relation": "two implementation paths, contract drift, or a missing handoff"
    },
    "state-lifecycle": {
      "family": "state-data-model",
      "template": "state-machine",
      "primary_relation": "durable state, lifecycle transition, retry limit, or terminal condition"
    },
    "time-concurrency": {
      "family": "code-sequence",
      "template": "async-callback-sequence",
      "primary_relation": "time ordering, concurrency, lock ownership, lease, or transaction interleaving"
    }
  },
  "families": {
    "business-architecture": {
      "default_template": "capability-domain-map",
      "ready_templates": ["capability-domain-map"],
      "blocked_templates": ["participant-boundary", "rule-constraint-heatmap", "value-chain-map"]
    },
    "business-flow": {
      "default_template": "logic-flowchart",
      "ready_templates": ["dual-path-swimlane", "exception-branch-flow", "logic-flowchart"],
      "blocked_templates": ["bpmn-light-flow", "stage-track", "swimlane-flow"]
    },
    "code-sequence": {
      "default_template": "async-callback-sequence",
      "ready_templates": ["async-callback-sequence"],
      "blocked_templates": ["participant-timeline", "retry-exception-sequence", "transaction-boundary-sequence"]
    },
    "code-review": {
      "default_template": "code-review-package",
      "ready_templates": ["code-review-package"],
      "blocked_templates": []
    },
    "delivery-acceptance": {
      "default_template": "acceptance-ledger",
      "ready_templates": ["acceptance-ledger"],
      "blocked_templates": ["delivery-timeline", "evidence-swimlane", "risk-action-board"]
    },
    "fault-debugging": {
      "default_template": "causal-chain",
      "ready_templates": ["causal-chain"],
      "blocked_templates": ["before-after-flow", "bpmn-debug-flow", "debugging-sequence", "state-data-breakpoint"]
    },
    "state-data-model": {
      "default_template": "state-machine",
      "ready_templates": ["state-machine"],
      "blocked_templates": ["data-flow-model", "er-lite", "lifecycle-track", "state-event-matrix"]
    },
    "system-architecture": {
      "default_template": "workload-overview",
      "ready_templates": [
        "logical-layering",
        "workload-overview"
      ],
      "blocked_templates": []
    }
  }
}
