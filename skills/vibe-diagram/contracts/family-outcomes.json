{
  "schema_version": 1,
  "families": {
    "architecture": {
      "mode": "graph",
      "requires_edges": true,
      "requires_groups": false,
      "required_node_roles": [],
      "required_any_node_roles": [
        "system",
        "service",
        "component",
        "interface",
        "store",
        "external",
        "capability",
        "domain",
        "participant",
        "object",
        "rule",
        "source",
        "process",
        "sink",
        "symptom",
        "cause",
        "hypothesis",
        "repair",
        "verification"
      ]
    },
    "business-flow": {
      "mode": "flow",
      "requires_edges": true,
      "requires_groups": false,
      "required_node_roles": [
        "start",
        "end"
      ],
      "required_any_node_roles": [
        "activity",
        "decision",
        "event",
        "merge"
      ]
    },
    "code-sequence": {
      "mode": "sequence",
      "requires_edges": true,
      "requires_groups": false,
      "required_node_roles": [
        "participant"
      ],
      "required_any_node_roles": []
    },
    "state-machine": {
      "mode": "state",
      "requires_edges": true,
      "requires_groups": false,
      "required_node_roles": [
        "initial",
        "state"
      ],
      "required_any_node_roles": [
        "terminal",
        "cyclic"
      ]
    },
    "data-model": {
      "mode": "data",
      "requires_edges": true,
      "requires_groups": false,
      "required_node_roles": [],
      "required_any_node_roles": [
        "entity"
      ]
    }
  },
  "$comment": "仅支持五种基础图法；故障、审查、设计按任务内容独立检查。"
}
